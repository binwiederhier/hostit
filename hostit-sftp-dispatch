#!/bin/sh
# Global sftp Subsystem for hostit. For a routed (remote) app it relays sftp to
# the app's node via the privileged helper; for every other user -- a colocated
# app or the operator's own accounts -- it execs the real sftp-server unchanged.
# Wired as "Subsystem sftp" only on relay-enabled frontends (by ansible).
routes=/var/lib/hostit/ssh-routes
me=$(id -un)
if [ -f "$routes" ] && awk -F'\t' -v u="$me" '$1==u{found=1} END{exit !found}' "$routes"; then
    exec sudo -n /usr/bin/hostit-relay -s sftp
fi
for s in /usr/lib/openssh/sftp-server /usr/libexec/openssh/sftp-server /usr/lib/ssh/sftp-server; do
    [ -x "$s" ] && exec "$s"
done
echo "hostit: no sftp-server found on this host" >&2
exit 1
