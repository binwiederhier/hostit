# systemd template unit for hostit app containers, instantiated per app as
# hostit-app@<name>.service. The daemon enables and starts these; the container
# itself is created by the daemon with a uid mapping that makes container root
# the app's unprivileged user.
[Unit]
Description=hostit app %i
After=network-online.target
Wants=network-online.target

# Type=notify with the container created --sdnotify=conmon: conmon signals READY
# only once the container is actually running, so "systemctl start" (and the unit's
# active state) reflects a running container, not merely that podman was exec'd.
# This closes a race where a deploy hitting a just-created app would try to reload a
# container that had not finished starting. NotifyAccess=all lets conmon, a child of
# podman rather than the main process, deliver the notification.
[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/podman start --attach hostit-app-%i
ExecStop=/usr/bin/podman stop --time 2 hostit-app-%i
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
