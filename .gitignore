dist/
*.iml
.idea/
web/node_modules/
web/build/

# Built web assets are generated by "make web"; only the placeholder is tracked
control/site/*
!control/site/.gitkeep

# component build artifacts (the stray binaries `go build` drops in the repo
# root); the !/  lines keep the package DIRECTORIES of the same names tracked
/control
!/control/
/node
!/node/
/proxy
!/proxy/
/hostit
!/hostit/
__pycache__/
