# Managed by Ansible (hostit role) -- do not edit on the host.
# All options: see proxy.yml.example in the hostit source.

# hostit-proxy terminates TLS on :443 and serves apps from the table control
# pushes it. Single-box: it reaches control over the /run/hostit socket (no cert);
# a proxy on its own machine needs proxy-id, cluster-url and certs.
control-url: http://{{ hostit_control_http }}
{% if hostit_proxy_listen_metrics %}
# Prometheus /metrics (unauthenticated -- keep it internal).
listen-metrics: "{{ hostit_proxy_listen_metrics }}"
{% endif %}
