# Managed by Ansible (hostit role) -- do not edit on the host.
# All options and their defaults: see proxy.yml.example in the hostit source.

# hostit-proxy is the data plane: it terminates TLS on :443 and forwards each
# request to its app. It is a cluster member -- it dials control, is handed the
# routing table over that connection, and asks for certificates through it.
#
# Sharing a host with control, everything else defaults: the proxy is "local",
# it dials 127.0.0.1:2930, and it reads the credentials control mints for it
# under its data dir. A proxy on its own machine instead needs proxy-id,
# cluster-url and the three credential files that `hostit-control proxy add`
# prints.
control-url: http://{{ hostit_control_http }}
