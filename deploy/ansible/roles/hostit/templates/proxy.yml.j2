# Managed by Ansible, do not edit on the host. See proxy.yml.example for all options.
# The proxy is the data plane: it terminates TLS and serves apps from a cached
# table, so apps keep serving while control restarts. It dials control.

# Where control's plain-HTTP listener is (dashboard/API upstream + host fallback).
control-url: http://{{ hostit_control_listen_http }}

# This proxy's cluster identity. Colocated dials the /run/hostit socket (no certs);
# a remote proxy sets its own id and dials control's mTLS listener.
proxy-id: {{ hostit_proxy_id }}
cluster-url: {{ hostit_proxy_cluster_url }}
{% if hostit_proxy_remote %}
# A remote proxy's CA-signed cert (CN={{ hostit_proxy_id }}, OU=proxy).
cluster-cert-file: {{ hostit_proxy_cert_file }}
cluster-key-file: {{ hostit_proxy_key_file }}
cluster-ca-cert-file: {{ hostit_proxy_ca_file }}
{% endif %}
{% if hostit_proxy_listen_metrics_http %}
# Prometheus /metrics (unauthenticated -- keep it internal).
listen-metrics: "{{ hostit_proxy_listen_metrics_http }}"
{% endif %}
