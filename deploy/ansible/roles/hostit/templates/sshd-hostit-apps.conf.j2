# Managed by Ansible (hostit role) -- do not edit on the host.
# App users log in only to reach their own container; strip the forwarding that
# would let a tenant tunnel past it (metadata service, another app's port).
# scp/sftp/rsync are unaffected.
Match Group {{ hostit_apps_group }}
    AllowTcpForwarding no
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
    GatewayPorts no
    PermitUserRC no

# Included at the TOP of sshd_config, so reset the Match before the globals below.
Match all
