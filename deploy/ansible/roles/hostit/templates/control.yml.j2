# Managed by Ansible (hostit role) -- do not edit on the host.
# All options and their defaults: see control.yml.example in the hostit source.

base-domain: {{ hostit_domain }}

# Control's own data dir (registry, per-app certs, cluster CA). The unprivileged
# hostit-control user owns it via the unit's StateDirectory; leaving it unset
# would default to /var/lib/hostit, which control cannot write to as non-root.
data-dir: /var/lib/hostit/control
admin-token: {{ hostit_admin_token }}
tls: letsencrypt
{% if hostit_letsencrypt_email %}
letsencrypt-email: {{ hostit_letsencrypt_email }}
{% endif %}

# hostit-proxy terminates TLS in front and forwards here over loopback. That is
# the only shape: control never binds :443, and needs no setting to say so. It
# still MANAGES the certificates, and hands them to the proxy over the cluster
# link.
listen-http: {{ hostit_control_http }}

# Where members on OTHER machines dial in (mTLS). The node and proxy sharing
# This example runs everything on one host: control, node and proxy talk over
# the /run/hostit unix sockets (kernel peer-cred gate), so no cluster TLS certs
# and no listen-cluster. To add a node/proxy on ANOTHER machine, set
# listen-cluster here and issue each member a cert (see node.yml.example).
{% if hostit_aws_access_key_id %}

# One wildcard certificate for *.{{ hostit_domain }} via Route 53 (DNS-01),
# instead of a certificate per app issued on first request.
dns-provider: route53
aws-region: {{ hostit_aws_region }}
aws-access-key-id: {{ hostit_aws_access_key_id }}
aws-secret-key: {{ hostit_aws_secret_key }}
{% if hostit_aws_hosted_zone_id %}
aws-hosted-zone-id: {{ hostit_aws_hosted_zone_id }}
{% endif %}
{% endif %}
{% if hostit_google_client_id %}

# Web dashboard (Google OAuth). Empty runs token-only with no web login.
google-client-id: {{ hostit_google_client_id }}
google-client-secret: {{ hostit_google_client_secret }}
{% endif %}
{% if hostit_session_key %}
session-key: {{ hostit_session_key }}
{% endif %}
{% if hostit_admin_emails %}
# These emails become active admins on their first login.
admin-emails:
{% for email in hostit_admin_emails %}
  - {{ email }}
{% endfor %}
{% endif %}

{% if hostit_anthropic_api_key %}

# Built-in assistant on the metered Anthropic API.
anthropic-api-key: {{ hostit_anthropic_api_key }}
{% endif %}
{% if hostit_claude_code_oauth_token %}

# The operator's Claude subscription (Pro/Max): its models are offered alongside
# the API's, run as `claude -p` in a sandbox container. Its presence is the whole
# switch.
claude-code-oauth-token: {{ hostit_claude_code_oauth_token }}
{% endif %}
{% if hostit_ssh_relay | default(false) %}

# Optional single-hostname SSH relay gateway (see docs/features/ssh-access.md).
# Control writes the routes/known_hosts/per-app keys the system sshd uses and
# adds the relay key to remote apps' authorized_keys. EXPERIMENTAL; off by default.
ssh-relay: true
{% endif %}
{% if hostit_control_listen_metrics %}
# Prometheus metrics on a separate interface (unauthenticated -- keep it internal).
listen-metrics: "{{ hostit_control_listen_metrics }}"
{% endif %}

{% if hostit_outbound_allow_private_cidrs | default([]) %}
# The one outbound allow-list, applied everywhere hostit reaches out on an
# account's behalf: control's own user-supplied fetches (MCP/OAuth issuers), the
# preview container, and each node's app-container firewall (node.yml, same key).
outbound-allow-private-cidrs:
{% for cidr in hostit_outbound_allow_private_cidrs %}
  - {{ cidr }}
{% endfor %}
app-preview-allow-cidrs:
{% for cidr in hostit_outbound_allow_private_cidrs %}
  - {{ cidr }}
{% endfor %}
{% endif %}
