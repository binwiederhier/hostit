# Managed by Ansible (hostit role) -- do not edit on the host.
# All options and their defaults: see node.yml.example in the hostit source.

# hostit-node owns this machine's app work: containers, unix users, btrfs
# subvolumes and port rules. It dials control and does what it is told; control
# never dials it, so this host needs no inbound port for the cluster.
#
# "local" is the node that shares control's host. Its credentials are the pair
# control mints under its data dir, so nothing is enrolled by hand.
node-id: local
control-url: {{ hostit_control_cluster }}

# Where apps live, and the socket the in-container CLI reaches this node on.
apps-dir: {{ hostit_apps_dir }}
