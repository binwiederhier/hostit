# hostit server config -- copy to /etc/hostit/server.yml and edit.
# Only base-domain and admin-token are required; everything else has sane defaults.

# Apps are served at <app>.<base-domain>. Requires a wildcard DNS record:
#   *.apps.example.com. A <ip-of-this-host>
#   apps.example.com.   A <ip-of-this-host>   (for SSH and the bare domain)
base-domain: apps.example.com

# Bearer token for the admin REST API. Generate with: openssl rand -hex 24
admin-token: CHANGE-ME

# TLS: "letsencrypt" (default, on-demand per-subdomain certs) or "off" (plain
# HTTP on listen-http; for development or behind another TLS-terminating proxy).
# tls: letsencrypt
# letsencrypt-email: you@example.com

# Wildcard TLS via DNS-01, instead of on-demand per-subdomain certs. With a DNS
# provider configured hostit obtains ONE *.<base-domain> certificate, so a brand
# new app serves TLS immediately. Only "route53" is supported. The AWS values are
# optional and fall back to the usual AWS env vars / instance credentials.
# dns-provider: route53
# aws-region: us-east-1
# aws-access-key-id: ...
# aws-secret-key: ...
# aws-hosted-zone-id: ...

# Web login (Google OAuth). Leave empty to run token-only with no web app. Create
# credentials at https://console.cloud.google.com/apis/credentials with the
# redirect URI https://<base-domain>/auth/callback.
# google-client-id: ...
# google-client-secret: ...

# Emails that become active admins on their first Google login (skip approval).
# admin-emails:
#   - you@example.com

# Secret for signing session cookies. Generated and persisted under data-dir if
# left empty; set it only to share sessions across a rebuild.
# session-key: ...

# How often each app's disk usage is measured for the soft quota.
# disk-check-interval: 1h

# Listeners (defaults shown)
# listen-http: ":80"
# listen-https: ":443"
# listen-api: "127.0.0.1:2900"   # optional extra plain-HTTP admin API listener
# socket-file: /run/hostit/hostit.sock

# Directories (defaults shown)
# data-dir: /var/lib/hostit      # registry DB + certs
# apps-dir: /var/lib/hostit/apps # app user home directories

# Hostnames (defaults shown)
# api-host: apps.example.com   # admin API + web app hostname (default: <base-domain>)
# ssh-host: apps.example.com   # SSH hostname reported to clients (default: <base-domain>)

# Per-app loopback port range (defaults shown)
# port-min: 10000
# port-max: 19999
