# systemd unit for hostit-control, the control plane: web app, REST API,
# registry, placement, certificates. The .deb installs this to
# /lib/systemd/system/hostit-control.service; for manual installs copy it to
# /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now hostit
[Unit]
Description=hostit control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/hostit-control serve
Restart=on-failure
RestartSec=2

# An app can saturate the box -- a build, a busy loop, a fork bomb inside its own
# process cap. Containers compete fairly with each other by default, but the
# control plane must not be one of the competitors: without this, the dashboard
# and the API get slow exactly when someone needs them to stop an app.
CPUWeight=10000
IOWeight=1000

# Deliberately NOT RuntimeDirectory=hostit: systemd would delete and recreate
# /run/hostit on every restart, and app containers bind-mount that directory to
# reach the daemon's socket. A new directory inode leaves every running app
# looking at an empty one, so "hostit up" from inside a container stops working
# until it is recreated. The daemon creates the directory itself instead.

[Install]
WantedBy=multi-user.target
