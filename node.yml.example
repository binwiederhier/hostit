# hostit-node configuration -- copy to /etc/hostit/node/node.yml and edit.
#
# The node is the machine half: it runs this host's app containers, their unix
# users, btrfs subvolumes and port rules, and it does ONLY what control tells
# it to over the node RPC. It therefore holds none of control's settings: no
# admin token, no base domain, no OAuth, no TLS.
#
# On a host that also runs hostit-control, the two share nothing but the data
# directory (the node reads its mTLS credentials from data-dir/ipc, which
# control mints on first start) -- so a colocated node needs only node-id,
# control-url and the paths below.

# This node's identity: the CN of its certificate and its name in control's
# node registry. "local" is the colocated node; a remote node uses the name it
# was registered under (hostit-control node add <name>).
node-id: local

# Where control accepts node dial-ins, as host:port. The node DIALS control
# and never listens itself, so this is named like the proxy's control-url.
control-url: "127.0.0.1:2930"

# Cluster credentials for a REMOTE node, minted by `hostit-control node add`:
# possession of a CA-signed certificate plus its registry row IS membership,
# there is no enrollment protocol. Leave unset when colocated: the node then
# reads the credentials control minted under data-dir/ipc.
#node-cert-file: /etc/hostit/node/node.pem
#node-key-file: /etc/hostit/node/node.key
#cluster-ca-cert-file: /etc/hostit/node/cluster-ca.pem

# Node-local storage: data-dir holds the registry mirror control pushes (and,
# when colocated, the credentials above); apps-dir is the btrfs pool the app
# subvolumes live in; socket-file is the host path the node serves the app socket
# on (its own subdir is mounted into containers, where it lands at /run/hostit/hostit.sock).
data-dir: /var/lib/hostit/node
apps-dir: /var/lib/hostit/node/apps
socket-file: /run/hostit/node/app/hostit.sock

# App-container egress allow-list. By default an app container cannot reach the
# cloud metadata endpoint or any private network (link-local, RFC1918, CGNAT,
# and their IPv6 equivalents) -- so it cannot read node credentials or dial
# another app's backend. List the internal CIDRs your apps legitimately need
# (a private API, a private-IP DNS resolver); accepts are applied before the
# drop, both IPv4 and IPv6. Whitelist NARROWLY -- a whole node network re-exposes
# apps to each other. Loopback-stub (127.0.0.53) or public DNS needs nothing here.
# Set this to the SAME list as control's outbound-allow-private-cidrs.
# outbound-allow-private-cidrs:
#   - 10.20.0.0/24
