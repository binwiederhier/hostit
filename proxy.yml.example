# hostit-proxy configuration. The proxy is the data plane: it terminates TLS
# with certificate material managed by hostit-control and routes requests
# straight to apps from a locally cached table, so apps keep serving while
# control restarts. It dials control; control never dials it.

# Where hostit-control's local HTTP listener is (its listen-http when running
# the dashboard/API upstream and the unknown-host fallback.
control-url: http://127.0.0.1:2910

# This proxy's cluster identity. "local" is the colocated proxy, whose
# certificate control mints for itself; a proxy on its own machine gets its
# name and credentials from `hostit-control proxy add <name>`.
# proxy-id: local

# Control's cluster listener (its listen-cluster), where this proxy dials in for
# its configuration. Defaults to control-url's host on port 2930, which is
# right when the proxy shares control's machine.
# cluster-url: 127.0.0.1:2930

# The cluster credentials. The defaults are the pair control mints for the
# colocated proxy under its data dir; a remote proxy points these at the PEM
# blocks `hostit-control proxy add` printed.
# proxy-cert-file: /var/lib/hostit/control/ipc/proxy-local.pem
# proxy-key-file: /var/lib/hostit/control/ipc/proxy-local.key
# cluster-ca-cert-file: /var/lib/hostit/control/ipc/ca.pem

# Public listeners (defaults shown)
# listen-https: ":443"
# listen-http: ":80"

# Where the routing table and certificate material persist, so a proxy restart
# during a control outage still serves. Default shown.
# data-dir: /var/lib/hostit/proxy
