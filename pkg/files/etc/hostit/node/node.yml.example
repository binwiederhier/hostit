# hostit-node configuration -- copy to /etc/hostit/node/node.yml and edit.
# The node is the machine half: it runs this host's app containers, users, btrfs
# subvolumes and port rules, and only what control tells it to over the node RPC.
# It holds none of control's settings (no admin token, base domain, OAuth, TLS).

# This node's identity: its name in control's registry and, for a remote node, the
# CN of its cert. "local" is the colocated node (same host as control).
node-id: local

# Where the node dials control. Colocated: the unix socket (no certs). A REMOTE
# node instead dials control's mTLS listener as host:port, e.g. 10.0.0.1:2930.
control-url: "unix:/run/hostit/control/cluster.sock"

# Cluster credentials -- REMOTE nodes only (a colocated node leaves these unset and
# uses the socket above). Membership IS a CA-signed cert with CN = this node-id and
# OU = "node"; there is no enrollment command. Issue it from your cluster CA
# (openssl recipe below) and point at the three files:
# cluster-cert-file: /etc/hostit/node/node.crt
# cluster-key-file: /etc/hostit/node/node.key
# cluster-ca-cert-file: /etc/hostit/node/cluster-ca.crt
#
# Generate the CA once, then a cert per member (control, each node, each proxy).
# ECDSA P-256; CN = member id, OU = its role (control | node | proxy):
#   openssl ecparam -name prime256v1 -genkey -noout -out cluster-ca.key
#   openssl req -x509 -new -key cluster-ca.key -days 3650 -out cluster-ca.crt \
#     -subj "/CN=hostit-control-ca" -addext "basicConstraints=critical,CA:TRUE" \
#     -addext "keyUsage=critical,keyCertSign"
#   openssl ecparam -name prime256v1 -genkey -noout -out node.key
#   openssl req -new -key node.key -out node.csr -subj "/CN=<node-id>/OU=node"
#   openssl x509 -req -in node.csr -CA cluster-ca.crt -CAkey cluster-ca.key \
#     -days 1825 -out node.crt -extfile <(printf \
#     "subjectAltName=DNS:<node-id>\nextendedKeyUsage=serverAuth,clientAuth\nkeyUsage=critical,digitalSignature")
#
# Protect the keys: chmod 600 *.key. NEVER deploy or commit cluster-ca.key --
# it stays on your workstation; only per-member certs/keys go to the hosts.

# REMOTE node only: where it publishes app ports, and who may reach them (the
# proxy addresses). apps-allowed-addresses is required once apps-bind-address is set.
# apps-bind-address: 10.0.0.2:0
# apps-allowed-addresses:
#   - 10.0.0.1

# Hostname control advertises for `ssh <app>@...` on this node (else base domain).
# A remote node must set its own reachable address, or its apps' SSH lands on control.
# ssh-host: node1.example.com

# App-container egress allow-list. By default a container cannot reach the cloud
# metadata endpoint or any private network (link-local, RFC1918, CGNAT, and their
# IPv6 equivalents) -- so it cannot read node credentials or another app's backend.
# List the internal CIDRs your apps legitimately need; whitelist NARROWLY. Set this
# to the SAME list as control's outbound-allow-private-cidrs.
# outbound-allow-private-cidrs:
#   - 10.20.0.0/24

# Prometheus /metrics (unauthenticated -- keep it internal).
# listen-metrics: ":9100"

# Node-local storage (defaults shown; ansible sets these). data-dir holds the
# registry mirror control pushes; apps-dir is the btrfs pool the app subvolumes
# live in; socket-file is the app socket mounted into each container.
# data-dir: /var/lib/hostit/node
# apps-dir: /var/lib/hostit/node/apps
# socket-file: /run/hostit/node/app/hostit.sock
