# hostit control-plane config -- copy to /etc/hostit/control/control.yml and edit.
# Only base-domain and admin-token are required; everything else has a default.
# This file holds secrets: after copying, run
#   chown hostit-control:hostit-control control.yml && chmod 600 control.yml

# Apps are served at <app>.<base-domain>. Needs a wildcard DNS record:
#   *.apps.example.com  A  <ip-of-this-host>
#   apps.example.com    A  <ip-of-this-host>   (bare domain, for SSH)
base-domain: apps.example.com

# Bearer token for the admin REST API (min 16 chars). Generate: openssl rand -hex 24
admin-token: CHANGE-ME

# TLS for app subdomains: "letsencrypt" (default, an on-demand cert per subdomain
# on first request) or "off" (plain HTTP, for dev or behind another TLS proxy).
# tls: letsencrypt
# letsencrypt-email: you@example.com

# Wildcard TLS via DNS-01 instead: one *.<base-domain> cert, so a brand-new app
# serves HTTPS immediately. Only "route53" is supported; the AWS values fall back
# to the usual env vars / instance credentials when omitted.
# dns-provider: route53
# aws-region: us-east-1
# aws-access-key-id: ...
# aws-secret-key: ...
# aws-hosted-zone-id: ...

# Web login via Google OAuth (leave unset to run token-only, no web app). Create
# credentials at https://console.cloud.google.com/apis/credentials with redirect
# URI https://<base-domain>/auth/callback.
# google-client-id: ...
# google-client-secret: ...

# Emails made admins on their first Google login (others must be approved).
# admin-emails:
#   - you@example.com

# Multi-machine only: where members on OTHER hosts dial in over mTLS. Leave unset
# on a single box (the colocated node/proxy use the /run/hostit socket, no certs).
# When set, control needs its own cert (CN=control) plus the CA every member cert
# chains to -- issue them from your cluster CA (openssl recipe in node.yml.example);
# hostit does not mint them.
# listen-cluster: 10.0.0.1:2930
# cluster-cert-file: /etc/hostit/control/control.crt
# cluster-key-file: /etc/hostit/control/control.key
# cluster-ca-cert-file: /etc/hostit/control/cluster-ca.crt

# Connections: accounts users attach and grant to their apps. Each provider needs
# an OAuth client YOU register with it (there is no shared hostit client); a
# provider with no entry is not offered. Calendar/Gmail reuse google-client-id
# above when omitted. Pasted credentials (IMAP, API keys) need nothing here.
# Gmail's read scope needs Google CASA review -- see docs/features/connections.md.
# connections:
#   slack:
#     client-id: ...          # api.slack.com/apps -> OAuth & Permissions
#     client-secret: ...
#   discord:
#     client-id: ...          # discord.com/developers/applications
#     client-secret: ...
#   github:
#     client-id: ...          # github.com/settings/developers -> OAuth Apps
#     client-secret: ...
#   jira:
#     client-id: ...          # developer.atlassian.com -> OAuth 2.0 (3LO)
#     client-secret: ...

# Built-in AI assistant: the in-browser chat that builds and changes apps. Unset
# = disabled. anthropic-api-key meters against your API credit;
# claude-code-oauth-token additionally offers your Claude Pro/Max plan, run per
# turn as a sandboxed `claude -p` (get the token with: claude setup-token).
# anthropic-api-key: sk-ant-...
# claude-code-oauth-token: ...

# How dashboard app cards preview: "live" scaled-down iframe (default),
# "screenshot" (headless chrome, re-shot every 6h and ~1min after edits), or
# "off". In screenshot mode "app-preview-isolation: strict" (default) confines the
# shot container to the target app + public internet; "off" applies no filter.
# app-preview: live
# app-preview-isolation: strict
# app-preview-allow-cidrs:
#   - 10.20.0.0/24

# Outbound allow-list for URLs hostit fetches on a user's behalf (MCP servers, a
# provider's OAuth issuer). By default anything resolving into private/loopback/
# link-local space is blocked -- that block is what keeps an account off the cloud
# metadata service. List only the internal ranges your services live on; a public
# address is always allowed. Set the node's outbound-allow-private-cidrs (and, if
# used, app-preview-allow-cidrs) to the SAME value. Never 0.0.0.0/0.
# outbound-allow-private-cidrs:
#   - 192.168.1.0/24

# Single-hostname SSH relay: `ssh <app>@<base-domain>` reaches any node's app.
# ssh-relay: true

# Advanced (defaults shown; ansible manages data-dir and listen-http). data-dir
# must match the systemd unit's StateDirectory (hostit/control).
# data-dir: /var/lib/hostit/control    # registry DB + certs
# listen-http: ":80"                   # plain HTTP (proxy upstream)
# listen-metrics: ":9100"              # Prometheus /metrics (unauthenticated; internal only)
# api-host: <base-domain>              # admin API + web app hostname
# ssh-host: <base-domain>              # SSH hostname reported to clients
# session-key: <generated if unset>   # cookie signing key
