# hostit control-plane config -- copy to /etc/hostit/control/control.yml and edit.
# Only base-domain and admin-token are required; everything else has a default.
# This file holds secrets: after copying, run
#   chown hostit-control:hostit-control control.yml && chmod 600 control.yml

# Apps are served at <app>.<base-domain>. Needs a wildcard DNS record:
#   *.apps.example.com  A  <ip-of-this-host>
#   apps.example.com    A  <ip-of-this-host>   (bare domain, for SSH)
base-domain: apps.example.com

# Bearer token for the admin REST API (min 16 chars). Generate: openssl rand -hex 24
admin-token: CHANGE-ME

# TLS for app subdomains: "letsencrypt" (default, an on-demand cert per subdomain
# on first request) or "off" (plain HTTP, for dev or behind another TLS proxy).
# tls: letsencrypt
# letsencrypt-email: you@example.com

# Wildcard TLS via DNS-01 instead: one *.<base-domain> cert, so a brand-new app
# serves HTTPS immediately. Only "route53" is supported; the AWS values fall back
# to the usual env vars / instance credentials when omitted.
# dns-provider: route53
# aws-region: us-east-1
# aws-access-key-id: ...
# aws-secret-key: ...
# aws-hosted-zone-id: ...

# Web login via Google OAuth (leave unset to run token-only, no web app). Create
# credentials at https://console.cloud.google.com/apis/credentials with redirect
# URI https://<base-domain>/auth/callback.
# google-client-id: ...
# google-client-secret: ...

# Emails made admins on their first Google login (others must be approved).
# admin-emails:
#   - you@example.com

# Multi-machine only: where members on OTHER hosts dial in over mTLS. Leave unset
# on a single box (the colocated node/proxy use the /run/hostit socket, no certs).
# When set, control needs its own cert (CN=control) plus the CA every member cert
# chains to -- issue them from your cluster CA (openssl recipe in node.yml.example);
# hostit does not mint them.
# listen-cluster: 10.0.0.1:2930
# cluster-cert-file: /etc/hostit/control/control.crt
# cluster-key-file: /etc/hostit/control/control.key
# cluster-ca-cert-file: /etc/hostit/control/cluster-ca.crt

# ===========================================================================
# Connections: accounts, credentials and tool servers users attach and grant to
# their apps. THREE kinds, configured three ways:
#
#   OAuth accounts     -> connections:  (below). Needs an OAuth client YOU register.
#   MCP tool servers   -> mcp-servers:  (below). Just a URL you give a name.
#   Pasted credentials (API keys, IMAP, database URLs, SSH keys) -> NO config.
#       They are built in; a user pastes one on the Connections page. There is
#       nothing to preconfigure, and no custom credential TYPE -- a custom
#       provider is always OAuth.
# ===========================================================================

# --- OAuth accounts. A provider with no client here is not offered. Calendar,
# Gmail and Drive reuse google-client-id above when omitted. The Gmail and Drive
# read scopes are restricted -- an instance offering them publicly needs Google's
# CASA review; see docs/features/connections.md.
#
# MINIMAL -- a built-in provider, just its client:
# connections:
#   github:
#     client-id: ...            # github.com/settings/developers -> OAuth Apps
#     client-secret: ...
#
# FULL -- a custom OAuth provider (a service hostit does not ship), every option:
# connections:
#   acme-sso:
#     label: Acme SSO                    # REQUIRED for a custom provider (names it in the menu)
#     client-id: ...
#     client-secret: ...
#     auth-url: https://sso.acme.example/authorize   # authorize + token endpoints,
#     token-url: https://sso.acme.example/token      #   OR set issuer: to discover both
#     issuer: https://sso.acme.example   # alternative to auth-url + token-url
#     revoke-url: https://sso.acme.example/revoke    # optional: hostit kills a token
#                                        #   here when a connection is removed/replaced
#     revoke-auth: bearer                # "bearer" (token as Bearer, Slack) or default (client creds)
#     auth-params: { access_type: offline }   # extra consent-URL params the provider needs
#     long-lived-token: false            # true if its token never expires (no refresh token)
#     user-token: false                  # true for a Slack-style token that acts AS the person
#     name-hint: Acme                    # what the add dialog pre-fills the name with
#     help: Register an app at sso.acme.example.   # one line: where to get the credential
#     short-description: Read your Acme projects.  # what the connection IS (add dialog)
#     long-description: >-               # documents the API for a granted app's assistant
#       REST API at https://api.acme.example, Bearer <token>. GET /projects lists projects.
#     allow-multiple: true               # false hides it once its app is connected (Slack-style
#                                        #   shared token: a 2nd connection would only alias the 1st)
#     scope-options:                     # permission checkboxes; on a BUILT-IN these REPLACE the defaults
#       - { key: projects, label: Read projects, scopes: [projects:read], default: true }
#       - { key: write,    label: Write,         scopes: [projects:write] }

# --- MCP tool servers offered to everyone by name (a user can still paste any URL).
#
# MINIMAL:
# mcp-servers:
#   deepwiki:
#     url: https://mcp.deepwiki.com/mcp
#
# FULL:
# mcp-servers:
#   linear:
#     label: Linear                      # what a user picks from the menu (defaults to the key)
#     url: https://mcp.linear.app/mcp
#     help: Issues and projects from your Linear workspace.

# Built-in AI assistant: the in-browser chat that builds and changes apps. Unset
# = disabled. anthropic-api-key meters against your API credit;
# claude-code-oauth-token additionally offers your Claude Pro/Max plan, run per
# turn as a sandboxed `claude -p` (get the token with: claude setup-token).
# anthropic-api-key: sk-ant-...
# claude-code-oauth-token: ...

# Instance-wide instructions appended to every app's assistant prompt and every
# /info response: house rules, what this instance is for, deployment notes. This
# is the DEFAULT only -- an admin can override it live on the web admin page,
# where "Reset to default" clears that override back to this value.
# info-prompt: >-
#   This is the acme.co internal instance. Prefer Postgres over SQLite for
#   anything shared, and keep persistent data under data/.

# The AI model a fresh app's assistant starts on (users can still switch per
# app). A mode id like "anthropic-sonnet-5" or "claude-opus-5"; empty picks the
# newest configured model. Overridable live on the admin page; an id no
# configured backend serves is ignored.
# default-assistant-model: anthropic-sonnet-5

# Public app gallery ("Explore"): when true, a user can put a PUBLIC app on a
# gallery every logged-in member can browse (never the anonymous internet). Off
# by default; overridable live on the admin page.
# app-listing: false

# How dashboard app cards preview: "live" scaled-down iframe (default),
# "screenshot" (headless chrome, re-shot every 6h and ~1min after edits), or
# "off". In screenshot mode "app-preview-isolation: strict" (default) confines the
# shot container to the target app + public internet; "off" applies no filter.
# app-preview: live
# app-preview-isolation: strict
# app-preview-allow-cidrs:
#   - 10.20.0.0/24

# Grace period between a user deleting an app and the app actually being removed.
# During it the app is hidden from its owner but still listed for admins, who can
# restore it -- a safety net for an accidental delete. A Go duration ("168h") or a
# day count ("7d"); default 7 days. "0" removes at once (still asynchronously).
# soft-delete-duration: 7d

# Outbound allow-list for URLs hostit fetches on a user's behalf (MCP servers, a
# provider's OAuth issuer). By default anything resolving into private/loopback/
# link-local space is blocked -- that block is what keeps an account off the cloud
# metadata service. List only the internal ranges your services live on; a public
# address is always allowed. Set the node's outbound-allow-private-cidrs (and, if
# used, app-preview-allow-cidrs) to the SAME value. Never 0.0.0.0/0.
# outbound-allow-private-cidrs:
#   - 192.168.1.0/24

# Single-hostname SSH relay: `ssh <app>@<base-domain>` reaches any node's app.
# ssh-relay: true

# Advanced (defaults shown; ansible manages data-dir and listen-http). data-dir
# must match the systemd unit's StateDirectory (hostit/control).
# data-dir: /var/lib/hostit/control    # registry DB + certs
# listen-http: ":80"                   # plain HTTP (proxy upstream)
# listen-metrics: ":9100"              # Prometheus /metrics (unauthenticated; internal only)
# api-host: <base-domain>              # admin API + web app hostname
# ssh-host: <base-domain>              # SSH hostname reported to clients
# session-key: <generated if unset>   # cookie signing key
