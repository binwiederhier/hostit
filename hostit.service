# systemd unit for the hostit daemon. The .deb installs this to
# /lib/systemd/system/hostit.service; for manual installs copy it to
# /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now hostit
[Unit]
Description=hostit mini-app platform
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/hostit serve
Restart=on-failure
RestartSec=2

# Deliberately NOT RuntimeDirectory=hostit: systemd would delete and recreate
# /run/hostit on every restart, and app containers bind-mount that directory to
# reach the daemon's socket. A new directory inode leaves every running app
# looking at an empty one, so "hostit up" from inside a container stops working
# until it is recreated. The daemon creates the directory itself instead.

[Install]
WantedBy=multi-user.target
